{
  "manifest_version": 2,
  "name": "论文翻译 (Paper Translator)",
  "version": "0.1.0",
  "description": "将选中的英文 PDF 论文通过 LLM 翻译为中文，保留公式与表格结构，并生成可导入 Zotero 的中译 HTML / PDF 附件。基于 paper-translator 技能。",
  "author": "15617",
  "homepage_url": "https://github.com/15617/zotero-paper-translator",
  "applications": {
    "zotero": {
      "id": "zotero-paper-translator@15617.github.io",
      "update_url": "https://github.com/15617/zotero-paper-translator/releases/latest/download/update.json",
      "strict_min_version": "7.0",
      "strict_max_version": "7.*"
    }
  },
  "options_ui": {
    "page": "preferences.xhtml",
    "open_in_tab": true
  }
}
